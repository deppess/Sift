#!/bin/zsh
set -euo pipefail

# Builds an ad-hoc-signed local application bundle. Its bundle identifier gives macOS network
# monitors a consistent identity when the bundled executable is launched through the `sift`
# launcher installed by install-local.

root="${0:A:h:h}"
configuration="${SIFT_BUILD_CONFIGURATION:-release}"
output="${SIFT_APP_OUTPUT:-$root/.build/Sift.app}"
identifier="${SIFT_BUNDLE_IDENTIFIER:-org.deppes.sift}"
version="$(sed -nE 's/.*current = "([^"]+)".*/\1/p' "$root/Sources/SiftCore/SiftVersion.swift")"

if [[ -z "$version" ]]; then
    print -u2 "Unable to determine Sift's version."
    exit 1
fi
if [[ "$output" != /*.app || "$output" == "/" ]]; then
    print -u2 "SIFT_APP_OUTPUT must be an absolute .app path."
    exit 2
fi

cd "$root"
swift build -c "$configuration" --product sift
binary="$(swift build -c "$configuration" --show-bin-path)/sift"

rm -rf "$output"
mkdir -p "$output/Contents/MacOS"
cp "$binary" "$output/Contents/MacOS/sift"

# Build the system app icon from the artwork shipped with the repository. The original is
# 512 pixels, so use it at native resolution for the largest representation and downsample
# smaller ones; do not upscale it to a fictitious 1024-pixel source.
icon_source="$root/Assets/icon.png"
temporary="$(mktemp -d "${TMPDIR:-/tmp/}sift-icon.XXXXXX")"
trap 'rm -rf "$temporary"' EXIT
iconset="$temporary/Sift.iconset"
mkdir -p "$iconset" "$output/Contents/Resources"
for size in 16 32 64 128 256; do
    sips -z "$size" "$size" "$icon_source" --out "$iconset/icon_${size}x${size}.png" >/dev/null
done
cp "$iconset/icon_32x32.png" "$iconset/icon_16x16@2x.png"
cp "$iconset/icon_64x64.png" "$iconset/icon_32x32@2x.png"
cp "$iconset/icon_256x256.png" "$iconset/icon_128x128@2x.png"
cp "$icon_source" "$iconset/icon_256x256@2x.png"
cp "$icon_source" "$iconset/icon_512x512.png"
iconutil -c icns "$iconset" -o "$output/Contents/Resources/Sift.icns"

cat > "$output/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>sift</string>
    <key>CFBundleIdentifier</key>
    <string>$identifier</string>
    <key>CFBundleName</key>
    <string>Sift</string>
    <key>CFBundleIconFile</key>
    <string>Sift.icns</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$version</string>
    <key>CFBundleVersion</key>
    <string>$version</string>
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>
</dict>
</plist>
EOF

codesign --force --sign - --identifier "$identifier" --timestamp=none "$output"
codesign --verify --strict --verbose=2 "$output"
if [[ -n "${SIFT_APP_ARCHIVE:-}" ]]; then
    archive="${SIFT_APP_ARCHIVE:A}"
    [[ "$archive" != "/" && "$archive" == *.zip ]] || { print -u2 "SIFT_APP_ARCHIVE must be an absolute .zip path."; exit 1; }
    mkdir -p "${archive:h}"
    rm -f "$archive"
    ditto -c -k --sequesterRsrc --keepParent "$output" "$archive"
    printf '%s\n' "Created app archive: $archive"
fi
printf '%s\n' "Built locally signed app: $output"
